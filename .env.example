# ============================================================
# MIA — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite .env.local no git
# ============================================================

# ------------------------------------------------------------
# Google Gemini (OBRIGATÓRIO para funcionar sem pagar)
# Criar em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=

# ------------------------------------------------------------
# Supabase (OBRIGATÓRIO)
# Criar projeto em: https://supabase.com
# Pegar em: Project Settings > API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# OPCIONAIS — só configurar quando for usar
# ------------------------------------------------------------

# Claude API (opcional — melhora qualidade das respostas)
# Criar em: https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Stripe (opcional — só para quando for vender)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRO_PRICE_ID=price_...

# OpenAI (opcional — para RAG com embeddings text-embedding-3-small)
# OPENAI_API_KEY=

# Resend (opcional — para emails transacionais)
# RESEND_API_KEY=
